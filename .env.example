# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Neon Serverless PostgreSQL Connection String (Pooled or Direct)
DATABASE_URL=postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Hark Chrome Companion Extension ID (32-character ID from chrome://extensions or Web Store)
NEXT_PUBLIC_HARK_EXTENSION_ID=

# Optional Chrome Web Store published extension URL
NEXT_PUBLIC_CHROME_WEBSTORE_URL=
