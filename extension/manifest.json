{
  "manifest_version": 3,
  "name": "Hark for MS Teams",
  "version": "1.0.0",
  "description": "Companion Chrome Extension for Hark academic assignment tracking and message ingestion from Microsoft Teams.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://teams.microsoft.com/*",
    "http://localhost:3000/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "https://localhost/*",
      "https://*.vercel.app/*",
      "https://your-production-domain.com/*"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hark for MS Teams Settings"
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js"
      ],
      "matches": [
        "https://teams.microsoft.com/*"
      ]
    }
  ]
}
